# Neon
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# Shared secret Vaani sends in the x-aangan-secret header on every tool call and webhook
AANGAN_TOOL_SECRET=change-me

# Telegram bot (create with @BotFather). Each designer's chat id lives in the designers table.
TELEGRAM_BOT_TOKEN=
TELEGRAM_FOUNDER_CHAT_ID=

# HubSpot private app token (scopes: crm.objects.contacts.write, crm.objects.deals.write)
HUBSPOT_TOKEN=
HUBSPOT_PIPELINE_ID=default
HUBSPOT_STAGE_BOOKED=appointmentscheduled
HUBSPOT_STAGE_REVIEW=qualifiedtobuy

# Cost tracking fallback, used only if Vaani's end-of-call report has no cost field (INR per minute)
VOICE_COST_PER_MIN_INR=8

# Vercel cron auth (Vercel sends this automatically as a Bearer token)
CRON_SECRET=
